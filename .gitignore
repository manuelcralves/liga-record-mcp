.venv/
__pycache__/
*.py[cod]
.pytest_cache/
data/cache.db
.env

# Generated dashboard: contains the private league table, which carries
# other members names and usernames. The repo is public.
docs/dashboard.html

# Round-by-round history: carries the league members names and usernames,
# same reason as the generated dashboard. Local only.
data/history.json

# Seeded design canvas: a 2 MB build artefact, regenerated from the
# .dc.html sources beside it. Versioning it would store a fresh copy on
# every reseed.
design/*.html
!design/*.dc.html

# zerozero page cache: other people's pages, fetched once and kept locally.
# Not ours to redistribute, and regenerable.
data/zerozero-cache/

# Player history scraped from zerozero: regenerable, and not ours to
# redistribute wholesale.
data/players.json

# Rebuildable from zerozero, and large.
data/last-season.json
data/rating-bridge.json

# Record's own regulation text, kept for checking what this code claims
# it says. Theirs, not ours to redistribute.
data/regulation/
data/season-*.json

# The private build writes a whole directory of pages, every one of them
# carrying twenty-nine other people. Ignoring the directory means a new page
# is covered the moment it exists, which a list of filenames is not.
docs/private/
